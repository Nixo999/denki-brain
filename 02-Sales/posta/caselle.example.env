# Modello. Il file vero va in ~/.config/denki-posta/caselle.env con permessi 600:
#   mkdir -p ~/.config/denki-posta && cp caselle.example.env ~/.config/denki-posta/caselle.env
#   chmod 600 ~/.config/denki-posta/caselle.env
# Il file vero non entra mai nel vault: il vault sta su GitHub.

# Server di register.it. Da confermare alla prima prova: se non risponde,
# provare authsmtp.register.it e imap.register.it.
SMTP_HOST=authsmtp.securemail.pro
SMTP_PORT=465
IMAP_HOST=imaps.securemail.pro
IMAP_PORT=993

# Le tre caselle di denkicode.com (decisione del 18/10). La casella personale di Patrick resta fuori.
CASELLA_1=
PASSWORD_1=
CASELLA_2=
PASSWORD_2=
CASELLA_3=
PASSWORD_3=

# Numero sotto la firma di Patrick. Vuoto = la firma non ha telefono.
TELEFONO=

# 0 = non parte niente verso le aziende: il giro dice solo cosa manderebbe.
# 1 = invio vero. Lo mette Nicola dopo aver letto le prime mail.
ATTIVO=0

# Indirizzo per le prove con `manda.py --prova`: riceve la mail al posto dell'azienda.
PROVA_A=
